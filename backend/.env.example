# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite:///./hackathon.db
# For PostgreSQL (e.g., on Render):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# JWT Authentication
JWT_SECRET_KEY=arenacore26-super-secure-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial Admin Credentials (used during auto-seeding if no admin exists)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@arenacore.psnacet.edu.in
DEFAULT_ADMIN_PASSWORD=Admin@ArenaCore2026

# Frontend & CORS
FRONTEND_URL=http://localhost:3000

# Future Google Sheets Integration (Do NOT enable until credentials are confirmed)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
